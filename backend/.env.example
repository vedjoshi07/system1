# ============================================================
# FINDLY Backend Environment Configuration
# Copy this file to .env and adjust values for your machine.
# ============================================================

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=findly
DB_USER=root
DB_PASS=

# CORS: comma-separated list of origins allowed to call the JSON API.
# Leave blank if frontend and backend share the same origin (XAMPP setup).
CORS_ALLOWED_ORIGIN=http://localhost:8080,http://127.0.0.1:8080

# Max upload size in bytes (5MB)
UPLOAD_MAX_SIZE=5242880
