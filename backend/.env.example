# ============================================================
# FINDLY Backend — Environment Configuration
# On Railway: DB_* vars are auto-injected by the MySQL plugin.
# On XAMPP / local: fill in values manually.
# ============================================================

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=findly
DB_USER=root
DB_PASS=

# CORS — set to your Netlify URL in production
CORS_ALLOWED_ORIGIN=https://gnu-findly-portal.netlify.app,http://localhost:8080,http://127.0.0.1:8080

# Max upload size in bytes (5 MB)
UPLOAD_MAX_SIZE=5242880
